# DOLIVE Linux 설정 예시. 실제 파일은 /etc/dolive/dolive.env (root:dolive, 0640)
# 설치 스크립트가 처음 한 번만 만들고, 이미 있으면 절대 덮어쓰지 않는다.
# 값 주변에 따옴표를 붙이지 않는다. 비밀값은 깃허브·채팅에 올리지 않는다.

# 참가자가 여는 주소 (https:// 와 / 없이). DNS A 레코드가 아래 공인 IP를 가리켜야 한다
DOLIVE_DOMAIN=live.example.com
# 드롭릿의 고정 공인 IPv4 (Reserved IP를 쓰면 그 주소). LiveKit이 참가자에게 이 주소로 소리·영상을 받으라고 알린다
DOLIVE_PUBLIC_IP=203.0.113.10
# 바깥 참가자의 통화 주소. 보통 wss://DOLIVE_DOMAIN
LIVEKIT_PUBLIC_URL=wss://live.example.com

# 통화 서버 키 이름. 새 설치는 dolive. 윈도우에서 옮기면 기존 apps/web/.env.local 의 이름을 그대로 가져온다
# (입장권 확인과 퇴장 알림이 모두 이 이름을 쓴다. 영문·숫자와 . _ - 만)
LIVEKIT_API_KEY=dolive
# 32자 이상 임의 값 (영문·숫자와 . _ ~ + / = - 만). 설치 스크립트가 새로 만들거나 기존 .env.local 에서 가져온다
LIVEKIT_API_SECRET=PUT_A_RANDOM_SECRET_HERE

# 도름스 연결 (https://dorms.school/connect 에 등록한 사이트 식별값과 주소)
DORMS_CLIENT_ID=00000000-0000-4000-8000-000000000000
DORMS_SITE_URL=https://live.example.com
