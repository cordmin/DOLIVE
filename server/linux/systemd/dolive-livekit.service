# DOLIVE 통화 서버. 설정 server/linux/livekit.yaml, 키 이름·비밀값 /etc/dolive/dolive.env (run-livekit.sh 가 환경변수로 넘김)
[Unit]
Description=DOLIVE LiveKit (통화 서버)
Wants=network-online.target
After=network-online.target
PartOf=dolive.target

[Service]
Type=simple
User=dolive
Group=dolive
EnvironmentFile=/etc/dolive/dolive.env
ExecStart=@DOLIVE_ROOT@/scripts/linux/run-livekit.sh
Restart=on-failure
RestartSec=5
# 78 = 설정 오류. 같은 오류로 계속 다시 켜지 않는다 (journalctl -u dolive-livekit 확인)
RestartPreventExitStatus=78
TimeoutStopSec=20
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=dolive.target
