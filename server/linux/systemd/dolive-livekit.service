# DOLIVE 통화 서버. 설정 server/linux/livekit.yaml, 키 이름·비밀값 /etc/dolive/dolive.env (run-livekit.sh 가 환경변수로 넘김)
[Unit]
Description=DOLIVE LiveKit (통화 서버)
Wants=network-online.target
After=network-online.target
PartOf=dolive.target

[Service]
Type=simple
User=dolive
Group=dolive
EnvironmentFile=/etc/dolive/dolive.env
ExecStart=@DOLIVE_ROOT@/scripts/linux/run-livekit.sh
Restart=on-failure
RestartSec=5
# 78 = 설정 오류. 같은 오류로 계속 다시 켜지 않는다 (journalctl -u dolive-livekit 확인)
RestartPreventExitStatus=78
TimeoutStopSec=20
LimitNOFILE=65536
# 통화 서버는 소리·영상 조각을 제 시간(10~20밀리초)에 내보내야 한다. 늦으면 보는 사람에게 손실로 보이고
# 서버가 "길이 막혔다"고 잘못 판단해 모두의 화질을 낮춘다. 그래서 CPU를 웹보다 먼저 받게 한다.
# (공용 CPU 서버는 빌린 CPU의 일부를 수시로 빼앗기므로 남은 몫을 통화에 먼저 준다)
Nice=-5
CPUWeight=10000
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=dolive.target
