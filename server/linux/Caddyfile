# DOLIVE Linux (DigitalOcean 고정 IP) 바깥 접속 설정.
# DOLIVE_DOMAIN 은 /etc/dolive/dolive.env 에서 systemd(dolive-caddy.service)가 넣는다.
# 인증서와 ACME 계정은 /var/lib/dolive-caddy 에 남아서 다시 설치하거나 업데이트해도 새로 받지 않는다.
{
	# 같은 서버의 다른 프로그램이 설정 창구(2019번)로 Caddy를 바꾸지 못하게 끈다. 설정 변경은 서비스 재시작으로 한다
	admin off
	# 방화벽은 TCP 443 만 연다. UDP 443(HTTP/3)은 쓰지 않는다
	servers {
		protocols h1 h2
	}
}

# 운영: 인증서를 443번(TLS-ALPN)으로만 받는다
(tls_acme) {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
}
# 일회용 시험 전용 (scripts/linux/tests): 외부 발급처에 묻지 않고 Caddy 내부 시험 인증서를 쓴다
(tls_internal) {
	tls internal
}

{$DOLIVE_DOMAIN} {
	import tls_{$DOLIVE_TLS:acme}

	# 웹의 마스터 판단(apps/web/lib/server.ts isLocal)은 X-Forwarded-For 를 본다.
	# Caddy 는 trusted_proxies 를 두지 않으면 바깥에서 보낸 X-Forwarded-For 를 버리고 실제 접속 주소로 채운다.
	# trusted_proxies 를 넣지 않는다. 마스터는 SSH 터널로 127.0.0.1:3000 에 직접 들어온다 (docs/linux/README.md)

	# LiveKit 신호(WebSocket)와 API
	@livekit path /rtc /rtc/* /twirp/*
	reverse_proxy @livekit 127.0.0.1:7880

	# 웹 (Next.js)
	reverse_proxy 127.0.0.1:3000
}
